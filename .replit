entrypoint = "training/sbe-governance-module/app/main.py"
run = "cd training/sbe-governance-module && python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-5000}"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd training/sbe-governance-module && python -m pip install -r requirements.txt"]
run = ["sh", "-c", "cd training/sbe-governance-module && python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-5000}"]

[[ports]]
localPort = 5000
externalPort = 80
