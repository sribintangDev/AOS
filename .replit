entrypoint = "training/sbe-governance-module/app/main.py"
run = "cd training/sbe-governance-module && python -m pip install -r requirements.txt && python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"

[deployment]
run = "cd training/sbe-governance-module && python -m pip install -r requirements.txt && python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
deploymentTarget = "cloudrun"
